{
	"name": "notestack",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^5",
			"@types/bun": "^1.3.4",
			"hono": "^4.8.2",
			"@orpc/server": "^1.12.2",
			"@orpc/openapi": "^1.12.2",
			"@orpc/zod": "^1.12.2",
			"@libsql/client": "0.15.15",
			"@orpc/client": "^1.12.2",
			"better-auth": "^1.3.4",
			"hono-rate-limiter": "^0.4.2"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run --filter '*' build",
		"check-types": "bun run --filter '*' check-types",
		"dev:native": "bun run --filter native dev",
		"dev:web": "bun run --filter web dev",
		"dev:server": "bun run --filter server dev",
		"db:push": "bun run --filter @notestack/db db:push",
		"db:studio": "bun run --filter @notestack/db db:studio",
		"db:generate": "bun run --filter @notestack/db db:generate",
		"db:migrate": "bun run --filter @notestack/db db:migrate",
		"db:local": "bun run --filter @notestack/db db:local",
		"check": "oxlint && oxfmt --write"
	},
	"dependencies": {
		"@notestack/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@notestack/config": "workspace:*",
		"@types/bun": "catalog:",
		"oxfmt": "^0.26.0",
		"oxlint": "^1.41.0",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.9"
}
