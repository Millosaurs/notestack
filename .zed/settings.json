{
  "context_servers": {
    "context7": {
      "source": "custom",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {}
    },
    "shadcn": {
      "source": "custom",
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"],
      "env": {}
    },
    "next-devtools": {
      "source": "custom",
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"],
      "env": {}
    }
  }
}
