{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown ",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs",
		"seed": "bun run src/seed.ts"
	},
	"dependencies": {
		"@notestack/api": "workspace:*",
		"@notestack/auth": "workspace:*",
		"@notestack/db": "workspace:*",
		"@notestack/env": "workspace:*",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"dotenv": "catalog:",
		"hono": "catalog:",
		"hono-rate-limiter": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@notestack/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.16.5",
		"typescript": "catalog:"
	}
}
